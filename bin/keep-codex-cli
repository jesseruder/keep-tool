#!/bin/sh
# Wrap an interactive Codex client so returning to the shell acknowledges its
# unread completion immediately. Abnormal exits retain the marker for recovery;
# Codex SessionEnd remains the fallback for clients that do not use this wrapper.

if [ "$#" -lt 1 ]; then
  echo "usage: keep-codex-cli <codex executable> [args...]" >&2
  exit 64
fi

keep_codex_executable=$1
shift
# Keep verifies automated input against the rendered draft. Codex's composer
# sparkles overwrite screen cells, making that verification fail even when the
# input is intact. Disable decorative effects in hosted clients only; keep the
# exact-draft and transcript-receipt checks intact.
if [ -n "${KEEP_PANE:-}" ]; then
  set -- -c tui.animations=false -c tui.whimsy=false "$@"
fi
keep_codex_token=$(/usr/bin/uuidgen 2>/dev/null | /usr/bin/tr '[:upper:]' '[:lower:]')
if [ -z "$keep_codex_token" ]; then
  keep_codex_token="$$-$(/bin/date +%s)"
fi

KEEP_CODEX_CLIENT_TOKEN="$keep_codex_token" "$keep_codex_executable" "$@"
keep_codex_status=$?

case "$keep_codex_status" in
  0|130)
    /usr/bin/printf '{"client_token":"%s"}' "$keep_codex_token" |
      "$(dirname "$0")/keep" hook codex client-end >/dev/null 2>&1 || true
    ;;
esac

exit "$keep_codex_status"
