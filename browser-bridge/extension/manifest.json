{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.1.0",
  "description": "Lets local agent sessions drive this browser through a native messaging host. One tab group per session.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "alarms",
    "scripting",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
