{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Keep console window: the loopback web app may set the dock badge, send notifications, use events, and check whether the clipboard contains an image",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:7777/*",
      "http://127.0.0.1:7777/*"
    ]
  },
  "permissions": [
    "core:event:default",
    "core:window:allow-set-badge-count",
    "notification:default",
    "allow-set-badge",
    "allow-clipboard-has-image",
    "allow-play-attention-sound",
    "allow-send-notification",
    "allow-get-notification-click",
    "allow-acknowledge-notification-click",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
