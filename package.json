{
  "name": "keep-tool",
  "private": true,
  "description": "Local work registry, agent console, and fleet automation",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "test": "node --require ./scripts/test-env.cjs --test bin/*.test.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "check:public": "node scripts/check-public.cjs",
    "prepack": "npm run check:public",
    "test:scenarios": "node bin/session-scenarios.js",
    "test:scenarios:browser": "npm run test:reliability:browser",
    "test:reliability": "node --require ./scripts/test-env.cjs --test bin/force-restart.test.js bin/restart-controls.test.js bin/runtime-restart.test.js bin/mcp-restart.test.js bin/summarize.test.js bin/session-summary.test.js bin/titles.test.js bin/background-jobs.test.js bin/code-mode-output.test.js bin/restart-ledger.test.js bin/daemon-restart.test.js bin/session-model.test.js bin/session-status.test.js bin/session-lifecycle.test.js bin/codex-lifecycle.test.js bin/codex.test.js bin/hosted-exit.test.js bin/session-restart.test.js bin/manual-close.test.js bin/session-cleanup.test.js bin/serve.test.js bin/host.test.js bin/ui-focus.test.js bin/terminal-view.test.js bin/console.test.js",
    "test:reliability:browser": "KEEP_BROWSER_TEST=1 node --require ./scripts/test-env.cjs --test bin/session-navigation-browser.test.js bin/terminal-profile-browser.test.js bin/terminal-scroll-browser.test.js",
    "mobile:theme": "node scripts/build-mobile-theme.mjs",
    "test:ui": "playwright test -c tests/ui/playwright.config.cjs",
    "ui:sandbox": "node tests/ui/fixture.cjs",
    "ui:sandbox:desktop": "node tests/ui/desktop.cjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.18.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "version": "0.1.0",
  "bin": {
    "keep": "bin/keep",
    "keep-wt": "bin/wt",
    "keep-reviewer": "bin/keep-reviewer",
    "wt": "bin/wt"
  },
  "files": [
    "bin/",
    "web/",
    "skills/",
    "desktop/README.md",
    "README.md",
    "scripts/",
    "docs/",
    "patches/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jesseruder/keep-tool.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
