{
  "name": "keep-tool",
  "private": true,
  "description": "Local work registry, agent console, and fleet automation",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "test": "node --test bin/*.test.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "check:public": "node scripts/check-public.cjs",
    "prepack": "npm run check:public"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "version": "0.1.0",
  "bin": {
    "keep": "bin/keep",
    "keep-wt": "bin/wt",
    "keep-reviewer": "bin/keep-reviewer"
  },
  "files": [
    "bin/",
    "web/",
    "skills/",
    "desktop/README.md",
    "README.md",
    "scripts/",
    "docs/",
    "patches/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jesseruder/keep-tool.git"
  }
}
